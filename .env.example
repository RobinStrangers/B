# Production Robinhood Chain RPC endpoint. Keep provider credentials server-side.
# The public endpoint is a rate-limited development fallback.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional browser RPC override. Leave empty to use the public Robinhood Chain fallback.
# If set, this must be an absolute http:// or https:// URL.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# Official and deployment-specific Robinhood Chain balance contracts.
NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Set this to the final public origin so social metadata uses absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Privy application identifier. Safe to expose in the browser.
NEXT_PUBLIC_PRIVY_APP_ID=cmt62ekbs000q0cjyo0fk4b7s

# Server-only Privy credential used for authoritative user and wallet lookups.
# Token signatures use Privy's public JWKS when this is absent, but wallet
# reconciliation remains disabled. Never prefix this value with NEXT_PUBLIC_.
PRIVY_APP_SECRET=

# Optional public verification key from Privy Dashboard > App settings > Basics.
# When set, token verification does not require a verification-key network lookup.
PRIVY_JWT_VERIFICATION_KEY=

# Server-only credentials used by the Vercel backend to access the existing
# Cloudflare D1 database through Cloudflare's REST API. Never prefix these with
# NEXT_PUBLIC_. The API token needs only D1 Read + D1 Write for this database.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Emergency compatibility only for a private Sites preview. Keep false for any
# public deployment so an authenticated Privy session can never fall back to a
# different Sites-dispatch identity.
ALLOW_SITES_AUTH_FALLBACK=false

# Isolated execution signer. Keep EXECUTION_MODE=off until the Lambda readiness,
# fee-scale, nonce-concurrency, and canary tests pass. `canary` permits only the
# server allowlist; `limited_live` is the free-tier beta mode.
EXECUTION_MODE=off
EXECUTION_FUNCTION_URL=
AWS_EXECUTION_REGION=eu-west-2

# Least-privilege IAM principal allowed to invoke only the Aventa Lambda Function
# URL. Configure these as encrypted Sites secrets; never expose them to the client.
AWS_EXECUTION_ACCESS_KEY_ID=
AWS_EXECUTION_SECRET_ACCESS_KEY=
AWS_EXECUTION_SESSION_TOKEN=

# Verified Robinhood Chain vault contract. Leave empty until the vault is deployed and audited.
NEXT_PUBLIC_VAULT_ADDRESS=

# Verified Robinhood Chain perpetual venue or clearinghouse. Leave empty until deployed and audited.
NEXT_PUBLIC_VENUE_ADDRESS=
